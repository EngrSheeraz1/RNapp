# Copy to .env.local. Replace this address with the computer's Wi-Fi IPv4 address.
EXPO_PUBLIC_API_URL=http://192.168.1.175:3001
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_FACEBOOK_APP_ID=
# Meta's mobile client token is a public app identifier, NOT the server App Secret.
EXPO_PUBLIC_FACEBOOK_CLIENT_TOKEN=
