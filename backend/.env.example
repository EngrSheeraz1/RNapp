NODE_ENV=development
HOST=0.0.0.0
PORT=3001
DATABASE_PATH=./data/auth.sqlite
JWT_SECRET=replace-with-at-least-32-random-characters
SESSION_DAYS=7
# Comma-separated browser origins; native requests do not need CORS.
CORS_ORIGINS=http://localhost:8081
DEV_LOG_RESET_CODES=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
GOOGLE_WEB_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v24.0
